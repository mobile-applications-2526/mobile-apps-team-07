    "@types/jest": "^29.5.12",
    "@types/react": "~19.1.10",
    "detox": "^20.25.0",
    "jest": "^29.7.0",
    "jest-expo": "^52.0.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2"
  },
  "private": true
