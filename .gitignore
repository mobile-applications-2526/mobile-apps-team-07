# React Native + Expo .gitignore
# Tailored for Expo-managed React Native projects

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Expo
.expo/
.expo-shared/
expo-web-build/
web-build/

# Metro / React Native packager cache
.metro-cache/

# Android
android/.gradle/
android/app/build/
android/**/build/
android/local.properties
*.keystore

# Kotlin Multiplatform / Compose
composeApp/build/

# iOS
# CocoaPods
ios/Pods/
ios/Podfile.lock
ios/build/
ios/DerivedData/

package-lock.json

# Xcode
*.xcworkspace/xcuserdata/
*.xcuserstate
*.pbxuser
*.mode1v3
*.mode2v3
*.perspectivev3
*.xcodeproj/project.xcworkspace/xcuserdata/

# Build outputs
*.apk
*.ap_
*.aab
*.ipa
*.dSYM

# Gradle
.gradle/

# Editor/IDE
.idea/
.vscode/
*.iml

# macOS
.DS_Store

# Environment variables
.env
.env.*

# Temporary files
*.tmp
*.temp
*.orig
*~
*.swp

# Generated by Expo CLI (keep ignored)
# Prevent tracking of the Expo-generated TypeScript declaration
expo-env.d.ts

# Keep lockfiles tracked (recommended). Remove the following lines if you want them ignored.
# package-lock.json
# yarn.lock

# End of file