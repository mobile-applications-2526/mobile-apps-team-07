{
  "project": {
    "name": "Vessel Management System",
    "type": "monorepo",
    "platforms": ["mobile", "backend", "frontend"]
  },
  "paths": {
    "mobile": ".",
    "backend": "../Vessel-Management-App-Backend",
    "frontend": "../Vessel-Management-App-Frontend/w-shipping-ops"
  },
  "agents": {
    "planning": {
      "prompt": ".claude/prompts/planning-agent.md",
      "subagents": ["prompt-engineer", "architecture", "task-breakdown"]
    },
    "testing": {
      "prompt": ".claude/prompts/testing-agent.md",
      "subagents": ["unit-mobile", "unit-backend", "unit-frontend", "e2e", "integration", "coverage"]
    },
    "mobile": {
      "prompt": ".claude/prompts/mobile-agent.md",
      "subagents": ["ui", "api", "state", "navigation", "offline", "native"]
    },
    "backend": {
      "prompt": ".claude/prompts/backend-agent.md",
      "subagents": ["controller", "service", "repository", "security", "document", "api-docs", "migration"]
    },
    "frontend": {
      "prompt": ".claude/prompts/frontend-agent.md",
      "subagents": ["ui", "page", "state", "api", "i18n", "performance"]
    },
    "cross-platform": {
      "prompt": ".claude/prompts/cross-platform-agent.md",
      "subagents": ["api-contract", "dto-sync", "schema-migration", "design-system"]
    }
  },
  "commands": {
    "test:all": "npm test && cd ../Vessel-Management-App-Backend && ./mvnw test",
    "test:mobile": "npm test",
    "test:backend": "cd ../Vessel-Management-App-Backend && ./mvnw test",
    "test:frontend": "cd ../Vessel-Management-App-Frontend/w-shipping-ops && npm test",
    "dev:mobile": "npm run dev",
    "dev:backend": "cd ../Vessel-Management-App-Backend && ./mvnw spring-boot:run",
    "dev:frontend": "cd ../Vessel-Management-App-Frontend/w-shipping-ops && npm run dev",
    "build:mobile": "npx expo build",
    "build:backend": "cd ../Vessel-Management-App-Backend && ./mvnw clean package",
    "build:frontend": "cd ../Vessel-Management-App-Frontend/w-shipping-ops && npm run build"
  },
  "conventions": {
    "mobile": {
      "testPattern": "__tests__/**/*.test.{ts,tsx}",
      "componentPattern": "components/**/*.tsx",
      "servicePattern": "services/*.service.ts"
    },
    "backend": {
      "testPattern": "src/test/java/**/*Test.java",
      "controllerPattern": "src/main/java/**/controller/*.java",
      "servicePattern": "src/main/java/**/service/*.java"
    },
    "frontend": {
      "testPattern": "src/__tests__/**/*.test.{ts,tsx}",
      "componentPattern": "src/components/**/*.tsx",
      "servicePattern": "src/services/*.service.ts"
    }
  }
}
